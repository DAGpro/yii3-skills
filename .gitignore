# Dependencies / build output
node_modules/
vendor/
.phpunit.cache/
evals/runtime-harness/composer.lock

# Eval runner output (results/<timestamp>/ per run)
evals/results/

# Local helper files
package.json

# Editors, AI assistants, and agent tooling: every root-level dot-directory
# is local-only by default, so a new tool never needs a new rule. Negate
# here anything the repository actually tracks.
/.*/
!/.github/

# Root-level local dot-files (assistant / MCP state)
/.*.json

/references/*
!/references/README.md
