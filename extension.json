{
  "$schema": "https://raw.githubusercontent.com/lee-to/ai-factory/2.x/schemas/extension.schema.json",
  "name": "yii3-skills",
  "version": "0.2.0",
  "description": "AI Factory extension with skills for generating Yii3 (yiisoft) PHP code: actions, forms, CRUD modules, REST API endpoints, DI configuration and DB migrations. Based on the official Yii3 guide.",
  "injections": [
    {
      "target": "aif-plan",
      "position": "prepend",
      "file": "./injections/plan.md"
    },
    {
      "target": "aif-improve",
      "position": "append",
      "file": "./injections/improve.md"
    },
    {
      "target": "aif-implement",
      "position": "prepend",
      "file": "./injections/implement.md"
    },
    {
      "target": "aif-verify",
      "position": "append",
      "file": "./injections/verify.md"
    },
    {
      "target": "aif-fix",
      "position": "append",
      "file": "./injections/fix.md"
    },
    {
      "target": "aif-review",
      "position": "append",
      "file": "./injections/review.md"
    },
    {
      "target": "aif-roadmap",
      "position": "append",
      "file": "./injections/roadmap.md"
    },
    {
      "target": "aif-architecture",
      "position": "append",
      "file": "./injections/architecture.md"
    }
  ],
  "skills": [
    "skills/yii3"
  ]
}
