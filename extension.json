{
  "$schema": "https://raw.githubusercontent.com/lee-to/ai-factory/2.x/schemas/extension.schema.json",
  "name": "yii3-skills",
  "version": "0.3.0",
  "description": "AI Factory extension with the yii3 agent skill: a stage-based Yii3 development workflow (bootstrap, bottom-up stages, production readiness gate) backed by 78 topic guides and thin workflow injections for plan/improve/implement/verify/fix/review/roadmap/architecture.",
  "injections": [
    {
      "target": "aif-plan",
      "position": "prepend",
      "file": "./injections/plan.md"
    },
    {
      "target": "aif-improve",
      "position": "append",
      "file": "./injections/improve.md"
    },
    {
      "target": "aif-implement",
      "position": "prepend",
      "file": "./injections/implement.md"
    },
    {
      "target": "aif-verify",
      "position": "append",
      "file": "./injections/verify.md"
    },
    {
      "target": "aif-fix",
      "position": "append",
      "file": "./injections/fix.md"
    },
    {
      "target": "aif-review",
      "position": "append",
      "file": "./injections/review.md"
    },
    {
      "target": "aif-roadmap",
      "position": "append",
      "file": "./injections/roadmap.md"
    },
    {
      "target": "aif-architecture",
      "position": "append",
      "file": "./injections/architecture.md"
    }
  ],
  "skills": [
    "skills/yii3"
  ]
}
