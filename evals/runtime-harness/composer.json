{
    "name": "yiisoft/yii3-skills-runtime-harness",
    "description": "Real L5 Yii 3 runtime integration harness executed by PHPUnit in CI.",
    "type": "project",
    "license": "BSD-3-Clause",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "httpsoft/http-message": "^1.1",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "yiisoft/data-response": "^2.2",
        "yiisoft/db": "^2.0",
        "yiisoft/db-migration": "^2.0",
        "yiisoft/db-sqlite": "^2.0",
        "yiisoft/definitions": "^3.4",
        "yiisoft/di": "^1.4",
        "yiisoft/event-dispatcher": "^1.1",
        "yiisoft/http": "^1.3",
        "yiisoft/hydrator": "^1.6",
        "yiisoft/hydrator-validator": "^2.0",
        "yiisoft/injector": "^1.2",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/mutex": "^1.1",
        "yiisoft/mutex-file": "^1.1",
        "yiisoft/queue": "^3.0 || dev-master",
        "yiisoft/router": "^4.0",
        "yiisoft/router-fastroute": "^4.0",
        "yiisoft/validator": "^2.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
