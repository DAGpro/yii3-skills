{
  "name": "acme/shop",
  "type": "project",
  "require": {
    "php": "^8.2",
    "yiisoft/di": "^1.4",
    "yiisoft/yii-runner-http": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "infection/infection": "^0.29.0",
    "roave/infection-static-analysis-plugin": "^1.3"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "infection": "vendor/bin/infection --threads=max --min-msi=80"
  }
}
